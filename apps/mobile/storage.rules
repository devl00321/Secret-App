rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is part of the couple
    function isPartnerOf(coupleId) {
      return request.auth != null && 
        firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.users.hasAny([request.auth.uid]);
    }

    // Emergency Evidence Photos
    match /emergency/{coupleId}/{userId}/{allPaths=**} {
      // Only the two partners can view the evidence
      allow read: if isPartnerOf(coupleId);
      
      // Only the owner of the phone can upload evidence
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chat Media Photos/Videos
    match /chat_media/{coupleId}/{allPaths=**} {
      allow read, write: if isPartnerOf(coupleId);
    }

    // Profile Photos (if any)
    match /profiles/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
