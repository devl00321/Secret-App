rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks if the authenticated user is part of the specific couple
    function isPartnerOf(coupleId) {
      let couple = get(/databases/$(database)/documents/couples/$(coupleId)).data;
      return isSignedIn() && (couple.users.hasAny([request.auth.uid]));
    }

    // --- Collection Rules ---

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // 2. Couples
    match /couples/{coupleId} {
      allow read: if isSignedIn() && resource.data.users.hasAny([request.auth.uid]);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.users.hasAny([request.auth.uid]);
      
      // 3. Messages (Nested Subcollection)
      // By nesting the match, we get the 'coupleId' from the path!
      match /messages/{messageId} {
        allow read: if isPartnerOf(coupleId);
        allow create: if isPartnerOf(coupleId);
        allow update: if isPartnerOf(coupleId);
        allow delete: if isOwner(resource.data.senderId);
      }
      
      // 5. Activities (Nested)
      match /activities/{activityId} {
        allow read, write: if isPartnerOf(coupleId);
      }
    }

    // 4. Invite Codes (Pairing)
    match /inviteCodes/{codeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      // Only the creator can delete their own invite code
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
