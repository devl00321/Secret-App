{
  "expo": {
    "name": "Luvv",
    "slug": "luvv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/custom-icon.png",
    "scheme": "luvv",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/custom-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ripu.loveapp",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "PASTE_YOUR_IOS_API_KEY_HERE"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSLocationWhenInUseUsageDescription": "Allow Love App to access your location while using the app.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Love App to access your location always to keep you and your partner safe.",
        "NSLocationAlwaysUsageDescription": "Allow Love App to access your location always to keep you and your partner safe."
      }
    },
    "android": {
      "package": "com.ripu.loveapp",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/custom-icon.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_CONTACTS"
      ],
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "PASTE_YOUR_ANDROID_API_KEY_HERE"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          },
          "android": {
            "ndkVersion": "26.1.10909125"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Love App to access your location always to keep you and your partner safe.",
          "locationWhenInUsePermission": "Allow Love App to access your location while using the app.",
          "locationAlwaysPermission": "Allow Love App to access your location always to keep you and your partner safe.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Love App to use FaceID for secure map access."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0270e1b-53d1-4493-83ed-e9c42f331499"
      }
    }
  }
}
